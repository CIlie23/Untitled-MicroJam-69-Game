[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Weapons/Orbs/orbs.gd" id="1_orbs"]
[ext_resource type="PackedScene" path="res://scenes/Weapons/Orbs/orb.tscn" id="2_orb"]

[ext_resource type="AudioStream" path="res://assets/sounds/player/orb.wav" id="9_sfx"]
[node name="Orbs" type="Node2D"]
script = ExtResource("1_orbs")
orb_scene = ExtResource("2_orb")

[node name="Ring" type="Node2D" parent="."]
unique_name_in_owner = true
visible = false

[node name="Cooldown" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[node name="Duration" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[node name="AttackSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("9_sfx")
volume_db = -16.0
max_polyphony = 3
bus = &"SFX"

[connection signal="timeout" from="Cooldown" to="." method="_on_cooldown_timeout"]
[connection signal="timeout" from="Duration" to="." method="_on_duration_timeout"]
[connection signal="attacked" from="." to="AttackSound" method="play" binds= [0.0]]
