[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Enemy/Abilities/fall_caster.gd" id="1_cast"]
[ext_resource type="PackedScene" path="res://scenes/Enemy/Abilities/lich_blast.tscn" id="2_blast"]
[ext_resource type="AudioStream" path="res://assets/sounds/lich/fall.wav" id="3_voice"]
[ext_resource type="PackedScene" path="res://scenes/Enemy/Abilities/fall_warning.tscn" id="4_warn"]

[node name="FallCaster" type="Node2D"]
script = ExtResource("1_cast")
blast_scene = ExtResource("2_blast")
warning_scene = ExtResource("4_warn")
first_delay = 10.5
damage = 22.0

[node name="CastTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 14.0

[node name="Voice" type="AudioStreamPlayer" parent="."]
volume_db = 6.0
stream = ExtResource("3_voice")
bus = &"SFX"

[connection signal="timeout" from="CastTimer" to="." method="_on_cast_timer_timeout"]
[connection signal="casting" from="." to="Voice" method="play" binds= [0.0]]
