[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/VictoryScreen/victory_screen.gd" id="1_victory"]
[ext_resource type="PackedScene" path="res://scenes/MenuScenes/Overlay/overlay_background.tscn" id="2_bg"]

[node name="VictoryScreen" type="Control"]
process_mode = 2
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_victory")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -220.0
offset_right = 300.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24
alignment = 1

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 96
text = "VICTORY"
horizontal_alignment = 1

[node name="Stats" type="Label" parent="VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 32
text = "Stats"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="Continue" type="Button" parent="VBoxContainer/Buttons"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
text = "CONTINUE"

[node name="Retry" type="Button" parent="VBoxContainer/Buttons"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
text = "RETRY"

[connection signal="pressed" from="VBoxContainer/Buttons/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBoxContainer/Buttons/Retry" to="." method="_on_retry_pressed"]
